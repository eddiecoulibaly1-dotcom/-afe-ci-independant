# Required for live debates
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models are configurable; pin versions in production.
OPENAI_MODEL=gpt-5.5
GEMINI_MODEL=gemini-3.8-flash
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.5

# Debate policy
MAX_ROUNDS=6
CONVERGENCE_SCORE=85

# Optional HTTP server
PORT=8787

# Optional durable debate memory (server-side only; never expose the service-role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DEBATE_STORE_FILE=./data/debates.json
