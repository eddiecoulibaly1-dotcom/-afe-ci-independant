# Required for live debates
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models are configurable; pin versions in production.
ARCHITECT_PROVIDER=openai
OPENAI_MODEL=gpt-5.5
RED_TEAM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.5

# Debate policy
MAX_ROUNDS=6
CONVERGENCE_SCORE=85

# Optional HTTP server
PORT=8787

# Supabase server-side configuration
# Prefer the current secret key name. Legacy service-role key remains supported for compatibility.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Safe to expose to the browser only as a publishable key; never put a secret/service-role key in client code.
SUPABASE_PUBLISHABLE_KEY=
DEBATE_STORE_FILE=./data/debates.json
