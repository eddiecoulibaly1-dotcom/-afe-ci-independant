# AFE-CI Debate Engine — BR-DEC-001 Preview / local environment
# Never commit real credentials. Configure API keys in the deployment secret store.

# Required live AI providers for the BR-DEC-001 comparison
OPENAI_API_KEY=
GEMINI_API_KEY=

# External research is required for the evidence-quality gate.
TAVILY_API_KEY=

# BR-DEC-001 agent routing (matches the isolated Vercel Preview branch)
ARCHITECT_PROVIDER=openai
ARCHITECT_MODEL=gpt-4.1-mini
RED_TEAM_PROVIDER=openai
RED_TEAM_MODEL=gpt-4.1-mini
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.8-flash

# Provider-wide defaults and same-provider fallback models
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.8-flash
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Debate protocol
MAX_ROUNDS=3
CONVERGENCE_SCORE=85

# Provider timeouts (milliseconds)
PROVIDER_TIMEOUT_MS=45000
FALLBACK_TIMEOUT_MS=30000
JUDGE_TIMEOUT_MS=45000
JUDGE_FALLBACK_TIMEOUT_MS=30000

# Optional HTTP server
PORT=8787

# Durable orchestration and private debate persistence (required for live execution)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback name supported by the server; use only if no secret key is available.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe publishable key; never use a secret/service-role key in client code.
SUPABASE_PUBLISHABLE_KEY=

# Optional local-only JSON store (not a substitute for Supabase durable execution)
DEBATE_STORE_FILE=./data/debates.json

# Optional market feed adapter; not required for BR-DEC-001 debate execution.
MARKET_PRICE_FEED_URL=
MARKET_PRICE_FEED_TOKEN=
