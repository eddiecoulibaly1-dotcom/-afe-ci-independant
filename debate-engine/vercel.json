{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/server.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/internal/agent-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/internal/coo-report-worker",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/internal/coo-dependency-worker",
      "schedule": "*/5 * * * *"
    }
  ]
}
